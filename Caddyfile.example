# /etc/caddy/Caddyfile — Caddy gets and renews the HTTPS certificate automatically.
# BASE_URL in .env must match, e.g. BASE_URL=https://boards.example.berkeley.edu

boards.example.berkeley.edu {
	reverse_proxy 127.0.0.1:8000
}

# Or serve under a path on a shared host (BASE_URL=https://lab.example.berkeley.edu/boards):
#
# lab.example.berkeley.edu {
# 	redir /boards /boards/
# 	handle_path /boards/* {
# 		reverse_proxy 127.0.0.1:8000
# 	}
# }
