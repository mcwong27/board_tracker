# Local development only. On Cloudflare Workers these come from wrangler.jsonc `vars`
# and from secrets set with `wrangler secret put` — see docs/deployment.md.
# Copy to .env (or .dev.vars for `pywrangler dev`) and fill in.

# Random string used to sign session cookies. Required when ENV=production.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# OAuth client from Google Cloud Console (APIs & Services > Credentials).
# Required unless DEV_LOGIN=1. See docs/google-oauth.md for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL users visit, without a trailing slash. Used to build the OAuth
# redirect URI (BASE_URL + /auth/callback) and to decide whether cookies are
# HTTPS-only. May include a path prefix, e.g. https://example.berkeley.edu/boards
BASE_URL=http://localhost:8000

# Service account used to check Google Group membership (sign-in access list and
# admin rights). Set one of the two; if both are set, the inline JSON wins.
# Required unless DEV_LOGIN=1. See docs/google-groups.md for setup.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Membership in this group is required to sign in at all. Berkeley's groups are
# addressed @lists.berkeley.edu, e.g. btrack-users@lists.berkeley.edu.
GOOGLE_USERS_GROUP=

# Membership in this group grants admin rights, e.g. btrack-admins@lists.berkeley.edu.
GOOGLE_ADMINS_GROUP=

# SQLite file for the local uvicorn loop, created on first run. Not used on Workers,
# where data lives in the D1 binding.
DATABASE_PATH=data/tracker.db

# 1 = replace Google sign-in with a plain email form (local testing only).
# The app refuses to start if DEV_LOGIN=1 and ENV=production.
DEV_LOGIN=0

# "production" (deployed) or "development" (local).
ENV=production
